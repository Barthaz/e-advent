{
  "name": "e-advent-api",
  "version": "1.0.0",
  "description": "REST API server with Stripe payments, WebSockets, email service, and MySQL",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "send-email": "node scripts/sendEmail.js",
    "vercel-build": "echo 'No build step required for Express.js'",
    "test": "jest --runInBand",
    "test:security": "jest --runInBand tests/security",
    "test:unit": "jest --runInBand tests/unit",
    "migrate": "node scripts/migrate.js",
    "migrate:seed-admin": "node scripts/migrate.js --seed-admin",
    "migrate:security": "node scripts/migrate-security.js",
    "migrate:interactive-delivered": "node scripts/migrate-interactive-delivered.js",
    "migrate:collaboration": "node scripts/migrate-collaboration.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "rest-api",
    "stripe",
    "websocket",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@e-advent/products": "1.0.0",
    "@vercel/blob": "^2.6.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.3",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.6.1",
    "stripe": "^14.7.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
