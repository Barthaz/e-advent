# Server Configuration
PORT=3000
NODE_ENV=development
# true = baza testowa + Stripe test + otwarty CORS
# false = baza produkcyjna + Stripe live + CORS allowlist
TESTING_MODE=true
FRONTEND_URL=http://localhost:5173
PANEL_URL=http://localhost:5174
# Production hosts (e-advent.pl, panel.e-advent.pl, test.e-advent.pl) are always allowed.
# Optional extra CORS origins, comma-separated.
CORS_ORIGINS=
API_BASE_URL=http://localhost:3000
EMAIL_LOGO_URL=https://e-advent.pl/eadvent-logo.png

# MySQL — wspólny host/port
MYSQL_HOST=h34.seohost.pl
MYSQL_PORT=3306

# MySQL — produkcja (TESTING_MODE=false)
MYSQL_DATABASE=srv74754_e-advent
MYSQL_USER=srv74754_e-advent
MYSQL_PASSWORD=your_prod_mysql_password

# MySQL — test (TESTING_MODE=true)
MYSQL_TEST_DATABASE=srv74754_e-advent-test
MYSQL_TEST_USER=srv74754_e-advent-test
MYSQL_TEST_PASSWORD=your_test_mysql_password

# Stripe — test (TESTING_MODE=true)
STRIPE_TEST_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_TEST_WEBHOOK_SECRET=whsec_your_test_webhook_secret_here

# Stripe — produkcja (TESTING_MODE=false)
STRIPE_LIVE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
STRIPE_LIVE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here

# Email Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=noreply@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM=noreply@e-advent.pl

# JWT Secret
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Cron (Vercel: 07:00 UTC = 8:00 Europe/Warsaw w grudniu; okienka + InPost + ponowienie maili)
CRON_SECRET=change-me-cron-secret

# Domyślne dane admina (scripts/migrate.js --seed-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123!

# Exact HTTPS origins allowed for remote PDF images (your Blob store/CDN); comma-separated.
# Local /uploads and inline JPG/PNG work without this setting. No wildcards.
PDF_IMAGE_ORIGINS=
# Optional. Large scratch PNG exports (>~3.5MB) are stored here when set. Without it, oversized PNG is sent as JPEG.
BLOB_READ_WRITE_TOKEN=

# InPost: osobne wartości na wdrożeniu testowym i produkcyjnym.
# Instrukcja i format opakowań/cennika: docs/INPOST.md
INPOST_ENV=sandbox
INPOST_API_TOKEN=
INPOST_ORGANIZATION_ID=
# Publiczny token mapy (może trafić do przeglądarki); token API powyżej nigdy.
INPOST_GEOWIDGET_TOKEN=
# prepaid: inpost_courier_c2c; aktywna umowa kurierska: inpost_courier_standard
INPOST_COURIER_SERVICE=inpost_courier_c2c
# Wybierz net lub gross po sprawdzeniu kwoty oferty z rozliczeniem konta.
INPOST_API_RATE_TAX=
# Własny sekret webhooka: 32 losowe bajty zapisane jako 64 znaki hex.
INPOST_WEBHOOK_SECRET=
# Faktyczne opakowania i ceny BRUTTO z Twojego cennika. Brak = blokada dostaw.
INPOST_PACKAGES_JSON=[]

# Wiadomości głosowe od Świętego Mikołaja.
# Migracja: npm run migrate:santa-messages -- --test (lub --prod)
SANTA_FULFILLMENT_ENABLED=true
SANTA_ADMIN_REVIEW_REQUIRED=true
SANTA_TTS_AUTOMATION_ENABLED=false
SANTA_MAX_AUDIO_SECONDS=120
SANTA_DRAFT_TTL_DAYS=30
SANTA_AUDIO_RETENTION_DAYS=365
SANTA_SIGNED_URL_TTL_SECONDS=900
# Sekrety tylko na backendzie (min. 32 losowe znaki). Bez nich klucze są wyprowadzane z JWT_SECRET.
SANTA_TOKEN_SECRET=
SANTA_DATA_KEY=
# Prywatne MP3. W produkcji wymagane R2; local służy wyłącznie do pracy lokalnej.
# Nie włączaj Public Development URL (r2.dev) ani publicznej domeny bucketu.
SANTA_AUDIO_STORAGE=r2
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# EU jurisdiction bucket: ustaw eu. Standardowy bucket: pozostaw puste.
R2_JURISDICTION=
# Wyłącznie dla npm run dev:santa z chronionym API Preview. Wygeneruj w Vercel
# w Deployment Protection → Protection Bypass for Automation. Lokalny tryb --local-api pomija to pole.
SANTA_VERCEL_AUTOMATION_SECRET=
# ElevenLabs (tylko gdy SANTA_TTS_AUTOMATION_ENABLED=true); bez tego admin wgrywa MP3 w panelu.
ELEVENLABS_API_KEY=
SANTA_VOICE_ID=
SANTA_MODEL_ID=
# Tylko lokalnie: zamiast SMTP zapisuje maile do storage/dev-mail i wypisuje linki w konsoli.
SANTA_DEV_MAIL_OUTBOX=false
