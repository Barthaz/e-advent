# Local / EAS public env for e-advent-app
# Copy to .env. Expo loads only .env (not this file).
# Local API:
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_ORDER_CALENDAR_URL=http://localhost:5173/stworz-kalendarz
# Production example:
# EXPO_PUBLIC_API_URL=https://apie-advent.vercel.app/api
# EAS preview/production builds take these from eas.json (".env" is gitignored).
# EXPO_PUBLIC_ORDER_CALENDAR_URL=https://e-advent.pl/stworz-kalendarz
