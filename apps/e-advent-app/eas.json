{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://apie-advent.vercel.app/api",
        "EXPO_PUBLIC_ORDER_CALENDAR_URL": "https://e-advent.pl/stworz-kalendarz"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://apie-advent.vercel.app/api",
        "EXPO_PUBLIC_ORDER_CALENDAR_URL": "https://e-advent.pl/stworz-kalendarz"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
