{
  "expo": {
    "name": "e-Advent",
    "slug": "e-advent-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/eadvent-mark.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eadvent.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/eadvent-mark.png",
        "backgroundColor": "#0f5132"
      },
      "package": "com.eadvent.app"
    },
    "web": {},
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/eadvent-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f5132"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikacja potrzebuje zdjęć, żeby zestawić ujęcie „wtedy” i „dziś”."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "082c87e1-1697-4a6f-859d-550e72852f6f"
      }
    }
  }
}
