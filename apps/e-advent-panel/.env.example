# Admin panel
# Copy to .env. Vite loads only .env (not this file).
VITE_API_PROXY_TARGET=http://localhost:3000
# Deployed API (dev proxy): VITE_API_PROXY_TARGET=https://apie-advent.vercel.app
# Build for own hosting (no /api proxy): set the API origin, calls go directly to it.
# VITE_API_URL=https://apie-advent.vercel.app
# Leave empty in dev / on Vercel (vercel.json rewrites /api).
VITE_STOREFRONT_URL=http://localhost:5173
