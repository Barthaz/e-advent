# Konfiguracja Apache dla React Router (SPA)
# Umieść ten plik w głównym katalogu z plikami dist/

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect before existing-file/directory shortcuts (including the homepage).
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  
  # Redirect www do non-www (301 Permanent Redirect)
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://e-advent.pl/$1 [R=301,L]

  # TYMCZASOWE: poza e-advent.pl (np. test.e-advent.pl) wpuszczaj tylko z dozwolonego IP.
  # Kolejne IP dopisuj jako: RewriteCond %{REMOTE_ADDR} !^1\.2\.3\.4$
  # /.well-known/ zostaje otwarte dla odnawiania certyfikatu SSL.
  RewriteCond %{HTTP_HOST} !^e-advent\.pl$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{REMOTE_ADDR} !^83\.23\.247\.138$
  RewriteRule ^ https://e-advent.pl/ [R=302,L]
  
  # Use the canonical URL for external requests. Internal rewrites end here.
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^(?:_pages/|app-shell\.html$) - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
  RewriteRule ^privacy$ /polityka-prywatnosci [R=301,L]
  RewriteRule ^terms$ /regulamin [R=301,L]
  RewriteRule ^(?:shipping|returns)$ /dostawa-i-zwroty [R=301,L]
  RewriteRule ^track-santa$ /sledz-mikolaja [R=301,L]
  RewriteRule ^stworz-kalendarz/puzzle$ /stworz-kalendarz [R=301,L]
  RewriteRule ^checkout$ /platnosc [R=301,L]
  RewriteRule ^success$ /sukces [R=301,L]
  RewriteRule ^preview$ /podglad [R=301,L]
  RewriteRule ^$ index.html [END]
  RewriteCond %{DOCUMENT_ROOT}/_pages/$1.html -f
  RewriteRule ^([a-z0-9/-]+)$ _pages/$1.html [END]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [END]
  RewriteRule ^(?:koszyk|platnosc|sukces|platnosc-blad|create|podglad|kalendarz|(?:kalendarz|calendar|podglad-okienka)/[^/]+|wiadomosc-od-mikolaja/(?:kreator|personalizacja/[^/]+)|od-mikolaja/(?:[^/]+|przyklad/[^/]+))$ app-shell.html [END]
  RewriteRule ^ - [R=404,L]
</IfModule>

# Cache dla plików statycznych
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Kompresja GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Właściwe typy MIME dla plików statycznych
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/gif .gif
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddDefaultCharset UTF-8
  AddCharset UTF-8 .html .css .js .json .xml .txt
</IfModule>

# Nagłówki bezpieczeństwa
# Podgląd okienek w panelu (iframe z panel.e-advent.pl) wymaga CSP zamiast X-Frame-Options.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{HTTP_HOST} == 'test.e-advent.pl'"
  Header set X-Content-Type-Options "nosniff"
  Header always unset X-Frame-Options
  Header unset X-Frame-Options
  Header always set Content-Security-Policy "frame-ancestors 'self' https://panel.e-advent.pl http://localhost:5174 http://127.0.0.1:5174"
  Header set X-XSS-Protection "1; mode=block"
  # index.html points at hashed bundles; without this a browser can keep an old one for days.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
